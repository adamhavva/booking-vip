# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=

# Firebase Admin SDK (server side only - never expose to the browser)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_ID=
# Keep the key on one line with escaped newlines (\n)
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK config (server side usage only)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Web SDK config (browser side - the API key is not a secret, but it
# is still tied to the project). Used by the customer login/register pages
# for the Google sign-in popup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public base URL of the deployment (used for the password-reset redirect).
NEXT_PUBLIC_SITE_URL=

# Admin area (Firebase Auth, server-side only)
# ADMIN_ENABLED is a deployment kill-switch: 1 = admin area reachable.
ADMIN_ENABLED=0
# Comma-separated list of emails allowed to use /admin.
# This is only the bootstrap allowlist: the first time an allowlisted email
# signs in to /admin/login its Postgres `User.role` becomes ADMIN. After that
# the database is the source of truth — revoke access by setting
# `role = 'USER'` on the `User` row.
ADMIN_EMAILS=
