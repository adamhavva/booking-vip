generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Akun pengguna — identitas berasal dari Firebase Auth (`id` = Firebase UID).
/// `role` adalah pembeda utama antara admin dan user biasa:
///   - "ADMIN" → hanya boleh masuk lewat `/admin`
///   - "USER"  → hanya boleh masuk lewat `/login` / `/register`
model User {
  id            String   @id
  email         String   @unique
  name          String?
  phone         String?
  /// "ADMIN" | "USER"
  role          String   @default("USER")
  emailVerified Boolean  @default(false)
  /// Loyalty points — the level is derived from the `LoyaltyLevel` table.
  points        Int      @default(0)
  levelId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      Booking[]
  savedCards    SavedCard[]
  reviews       Review[]
  level         LoyaltyLevel? @relation(fields: [levelId], references: [id])
  visaApplications VisaApplication[]
  pushSubscriptions PushSubscription[]
}

/// A loyalty tier — the thresholds live in the database, so they can be changed
/// without a deploy. `minPoints` is the number of points needed to reach the tier.
model LoyaltyLevel {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  minPoints   Int      @default(0)
  /// Points multiplier used when a booking is paid for.
  multiplier  Float    @default(1)
  /// ["Discount 5%", "Priority support"] — a free-form benefit list.
  benefits    Json     @default("[]")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)

  users       User[]
}

/// A saved payment card. The number is **encrypted** (AES-256-GCM) — only the last
/// four digits are kept in clear. The CVV is never collected nor stored.
model SavedCard {
  id              String   @id @default(uuid())
  userId          String
  /// "visa" | "mastercard" | "jcb" | …
  brand           String   @default("card")
  /// The last four digits, in clear.
  last4           String
  /// The full card number, encrypted.
  encryptedNumber String
  expMonth        Int
  expYear         Int
  holderName      String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A customer review (comment) on a product or a service line.
/// The replies form a parent → child → child tree through `parentId`.
model Review {
  id          String   @id @default(uuid())
  userId      String
  /// "product" | "serviceLine"
  subjectType String   @default("product")
  subjectId   String
  rating      Int      @default(5)
  body        String
  /// How many times the review was seen.
  views       Int      @default(0)
  /// How many likes it got.
  likes       Int      @default(0)
  /// The parent review when this is a reply.
  parentId    String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Review?  @relation("ReviewReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Review[] @relation("ReviewReplies")

  @@index([userId])
  @@index([subjectType, subjectId])
}

/// A visa application (the e-VOA service).
model VisaApplication {
  id             String   @id @default(uuid())
  /// A human readable application number.
  code           String   @unique
  userId         String?
  productId      String?
  fullName       String
  passportNumber String
  nationality    String
  dateOfBirth    DateTime
  arrivalDate    DateTime
  email          String
  phone          String
  /// "submitted" | "processing" | "approved" | "rejected"
  status         String   @default("submitted")
  note           String?
  totalUsdCents  Int      @default(0)
  createdAt      DateTime @default(now())

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// A promo code that cuts the price — either a fixed amount (USD cents) or a
/// percentage of the subtotal.
model PromoCode {
  id               String    @id @default(uuid())
  code             String    @unique
  title            String
  /// "fixed" | "percentage"
  type             String    @default("percentage")
  /// Fixed → USD cents. Percentage → 0-100.
  value            Int       @default(0)
  minTotalUsdCents Int       @default(0)
  usageLimit       Int?
  usedCount        Int       @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@index([active])
}

/// Searches submitted from the home page form.
/// Append-only history; `values` holds the entered form fields per service.
model SearchLog {
  id        String   @id @default(uuid())
  service   String
  href      String
  values    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Top-level service line (VIP, Transport, Tour, eVOA).
model ServiceLine {
  id        String        @id @default(uuid())
  slug      String        @unique
  label     String
  short     String
  badge     String?
  tone      String
  /// Copy of the service page (hero intro + body sections).
  introEn   String?
  introId   String?
  /// [{ heading, body }]
  sections  Json          @default("[]")
  /// [{ heading, body }] — Indonesian copy.
  sectionsId Json         @default("[]")
  /// Short feature list shown next to the booking panel.
  highlights Json         @default("[]")
  /// Short feature list — Indonesian.
  highlightsId Json       @default("[]")
  /// Filter tabs of the line catalog.
  tabs      Json          @default("[]")
  /// Filter tabs — Indonesian.
  tabsId    Json          @default("[]")
  imageUrl  String?
  imageCredit String?
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  types     ServiceType[]
  products  Product[]
  priceTiers PriceTier[]
  promos    Promo[]
  searchFields SearchField[]
}

/// Sub-category within a line (e.g. Meet & Greet, Sedan, Tourist eVOA).
model ServiceType {
  id        String    @id @default(uuid())
  lineId    String
  slug      String
  name      String
  /// Indonesian name — null falls back to `name` (content_i18n convention).
  nameId    String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  line      ServiceLine @relation(fields: [lineId], references: [id])
  products  Product[]

  @@unique([lineId, slug])
}

/// Generic place reference (used by Products for geographic scope).
/// Places form a full parent → child hierarchy: a row may point at a parent
/// row through `parentId`. The tree is generic — any place may parent any
/// other place — and drives the grouped / cascading dropdowns.
///
/// `level` is the administrative depth of the row:
///   region → country → province → city → district → village
/// with leaf spots (`airport`, `area`, `destination`) hanging below the
/// administrative node they belong to. `kind` is kept for backward
/// compatibility and mirrors `level` for the administrative rows; the leaf
/// kinds (airport / area / destination) are unchanged.
model Airport {
  id          String    @id @default(uuid())
  /// "airport" | "city" | "area" | "destination" | "region" | "country" |
  /// "province" | "district" | "village"
  kind        String    @default("airport")
  /// Administrative level: "region" | "country" | "province" | "city" |
  /// "district" | "village" | "airport" | "area" | "destination".
  level       String    @default("city")
  iataCode    String?   @unique
  name        String
  /// Indonesian place name — null falls back to `name`.
  nameId      String?
  city        String
  /// Indonesian city label — null falls back to `city`.
  cityId      String?
  country     String    @default("Indonesia")
  imageUrl    String?
  imageCredit String?
  active      Boolean   @default(true)
  /// Optional parent place (self relation).
  parentId    String?
  parent      Airport?  @relation("PlaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children    Airport[] @relation("PlaceHierarchy")
  /// Sort order inside the parent group (lower comes first).
  sortOrder   Int       @default(0)
  products    Product[]
  /// The tour products that use this place as their destination.
  destinations Product[] @relation("DestinationPlace")

  @@index([level])
  @@index([parentId])
}

/// A bookable product (VIP service, vehicle, tour package, eVOA plan).
/// `direction` allowed values: "arrival" | "departure" | "both"
/// `isAddOn`: true for add-on products that piggyback on other bookings.
model Product {
  id               String    @id @default(uuid())
  slug             String    @unique
  lineId           String
  serviceTypeId    String?
  airportId        String?
  title            String
  /// Indonesian title — null falls back to `title` (content_i18n convention).
  titleId          String?
  description      String    @default("")
  /// Indonesian description — null falls back to `description`.
  descriptionId    String?
  /// "arrival" | "departure" | "both"
  direction        String    @default("both")
  leadTimeHours    Int       @default(0)
  leadTimeDays     Int       @default(0)
  /// The transport vendor (the rental company / the tour operator).
  vendor           String?
  /// "manual" | "automatic"
  transmission     String?
  /// How many passengers the vehicle carries.
  seats            Int?
  /// "with_driver" | "without_driver"
  driverOption     String    @default("with_driver")
  /// "vendor_pickup" (free — pick up at the vendor) | "delivered" (extra fee).
  pickupPolicy     String?
  /// The tour destination — a place row of kind "destination".
  destinationId    String?
  /// The day-by-day itinerary of a tour package.
  itinerary        Json      @default("[]")
  /// Free-form key/value specs — [{ key, name }] (e.g. { key: "luggage",
  /// name: "2 koper" }). Rendered as the vehicle spec grid; `key` is the
  /// stable machine identifier, `name` the display text.
  specs            Json      @default("[]")
  included         Json      @default("[]")
  /// Indonesian included list — null falls back to `included`.
  includedId       Json?
  notIncluded      Json      @default("[]")
  /// Indonesian not-included list — null falls back to `notIncluded`.
  notIncludedId    Json?
  requirements     Json      @default("[]")
  /// Indonesian requirements list — null falls back to `requirements`.
  requirementsId   Json?
  isAddOn          Boolean   @default(false)
  imageUrl         String?
  imageCredit      String?
  tone             String    @default("from-sky-400 to-blue-600")
  ribbon           String?
  /// Indonesian ribbon — null falls back to `ribbon`.
  ribbonId         String?
  rating           Float?
  reviews          Int?
  durationLabel    String?
  /// Indonesian duration label — null falls back to `durationLabel`.
  durationLabelId  String?
  fromPriceUsdCents Int?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  line             ServiceLine   @relation(fields: [lineId], references: [id])
  serviceType      ServiceType?  @relation(fields: [serviceTypeId], references: [id])
  airport          Airport?      @relation(fields: [airportId], references: [id])
  destination      Airport?      @relation("DestinationPlace", fields: [destinationId], references: [id])
  packages         ProductPackage[]
  /// Add-ons this product offers (where this product is the host).
  hostAddOns       ProductAddOn[] @relation("HostAddOns")
  /// Add-ons where this product is the offered add-on itself.
  addOnOffers      ProductAddOn[] @relation("AddOnOffers")
  amenities        ProductAmenity[]
  bookingItems     BookingItem[]
  bookingAddOns    BookingAddOn[]

  @@index([lineId])
}

/// A purchasable package/variant of a Product (e.g. Standard per-pax tier, or a 6hr/10hr hourly hire).
/// `unitKind` allowed values: "per_pax" | "per_unit"
model ProductPackage {
  id              String    @id @default(uuid())
  productId       String
  label           String
  /// Indonesian label — null falls back to `label` (content_i18n convention).
  labelId         String?
  /// "per_pax" | "per_unit"
  unitKind        String    @default("per_pax")
  adultUsdCents   Int?
  childUsdCents   Int?
  infantUsdCents  Int?      @default(0)
  unitUsdCents    Int?
  durationHours   Int?
  extraHourUsdCents Int?
  /// The strikethrough "from" price (USD cents) — shown when a promo cuts
  /// the package price. Null means no promo.
  fromUsdCents    Int?
  /// Short package description shown on the selectable package card.
  description     String?
  /// Indonesian package description — null falls back to `description`.
  descriptionId   String?
  /// Free-form key/value info — [{ key, name, excluded? }]. Entries with
  /// `excluded: true` are costs the customer pays to the vendor directly
  /// (fuel, driver meals, …) and feed the pink excluded-costs banner.
  info            Json      @default("[]")
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  product         Product   @relation(fields: [productId], references: [id])
  bookingItems    BookingItem[]
}

/// Price band used for UI filtering of catalog results per line.
model PriceTier {
  id          String      @id @default(uuid())
  lineId      String?
  label       String
  maxUsdCents Int
  sortOrder   Int         @default(0)
  active      Boolean     @default(true)
  line        ServiceLine? @relation(fields: [lineId], references: [id])
}

/// An amenity (e.g. "With Driver", "AC"). Join table `ProductAmenity`.
model Amenity {
  id       String           @id @default(uuid())
  label    String           @unique
  products ProductAmenity[]
}

model ProductAmenity {
  id        String  @id @default(uuid())
  productId String
  amenityId String
  product   Product @relation(fields: [productId], references: [id])
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@unique([productId, amenityId])
}

/// Directed edge: product (host) offers product (addOn).
model ProductAddOn {
  id        String  @id @default(uuid())
  productId String
  addOnId   String
  sortOrder Int     @default(0)
  product   Product @relation("HostAddOns", fields: [productId], references: [id])
  addOn     Product @relation("AddOnOffers", fields: [addOnId], references: [id])

  @@unique([productId, addOnId])
}

/// A customer booking (one per checkout wizard).
/// `status` allowed values: "awaiting_payment" | "confirmed" | "cancelled" | "completed"
model Booking {
  id              String    @id @default(uuid())
  code            String    @unique
  /// "awaiting_payment" | "confirmed" | "cancelled" | "completed"
  status          String    @default("awaiting_payment")
  serviceAt       DateTime
  adultCount      Int       @default(1)
  childCount      Int       @default(0)
  infantCount     Int       @default(0)
  subtotalUsdCents Int
  addOnsUsdCents  Int       @default(0)
  totalUsdCents   Int
  currencyCode    String    @default("USD")
  fxRate          Float     @default(1)
  /// Firebase UID of the signed-in user (null for guest bookings).
  userId          String?
  /// The invoice number — `#INV/YYYY/MM/DD/4DIGIT/2RANDOM`.
  invoiceNumber   String?   @unique
  /// The promo code that was applied.
  promoCode       String?
  /// The discount that was applied (USD cents).
  discountUsdCents Int      @default(0)
  /// The tax lines that were applied — [{ key, label, value }].
  taxes           Json      @default("[]")
  taxUsdCents     Int       @default(0)
  /// The pickup point of a transport booking (address + coordinates).
  pickupLabel     String?
  pickupLat       Float?
  pickupLng       Float?
  /// The dropoff point of a transport booking (address + coordinates).
  dropoffLabel    String?
  dropoffLat      Float?
  dropoffLng      Float?
  /// A free-form note from the customer (the "special request").
  notes           String?
  /// "with_driver" | "without_driver"
  driverOption    String?
  /// "vendor_pickup" | "delivered"
  pickupPolicy    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contact         Contact?
  flight          FlightDetails?
  travelers       Traveler[]
  items           BookingItem[]
  addOns          BookingAddOn[]
  payments        Payment[]
  user            User?     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
}

model BookingItem {
  id            String   @id @default(uuid())
  bookingId     String
  productId     String
  packageId     String?
  label         String
  packageLabel  String?
  /// "per_pax" | "per_unit" | "per_day"
  unitKind      String
  adultCount    Int      @default(0)
  childCount    Int      @default(0)
  infantCount   Int      @default(0)
  /// How many units were booked — the number of rental days for "per_day".
  quantity      Int      @default(1)
  unitUsdCents  Int
  totalUsdCents Int
  booking       Booking  @relation(fields: [bookingId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  package       ProductPackage? @relation(fields: [packageId], references: [id])
}

model BookingAddOn {
  id             String  @id @default(uuid())
  bookingId      String
  addOnProductId String
  label          String
  quantity       Int     @default(1)
  unitUsdCents   Int
  totalUsdCents  Int
  booking        Booking @relation(fields: [bookingId], references: [id])
  addOnProduct   Product @relation(fields: [addOnProductId], references: [id])
}

model Contact {
  id              String  @id @default(uuid())
  bookingId       String  @unique
  /// "mr" | "mrs" | "ms"
  title           String?
  firstName       String
  lastName        String
  email           String
  phoneCountryCode String
  phone           String
  isGuestSelf     Boolean @default(true)
  notes           String?
  booking         Booking @relation(fields: [bookingId], references: [id])
}

model Traveler {
  id        String  @id @default(uuid())
  bookingId String
  fullName  String
  /// "adult" | "child" | "infant"
  kind      String
  sortOrder Int
  booking   Booking @relation(fields: [bookingId], references: [id])
}

model FlightDetails {
  id           String  @id @default(uuid())
  bookingId    String  @unique
  /// "arrival" | "departure"
  airportName  String?
  location     String?
  airline      String?
  flightCode   String?
  /// "arrival" | "departure"
  direction    String?
  booking      Booking @relation(fields: [bookingId], references: [id])
}

model PaymentMethod {
  id        String    @id @default(uuid())
  code      String    @unique
  label     String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  /// The gateway that settles this method: "xendit" | "paypal" | null (offline).
  provider  String?
  /// The method code as the gateway names it ("VA", "EWALLET", "QRIS", "CREDIT_CARD").
  providerMethodCode String?
  /// The currency the customer is charged in for this method.
  providerCurrency  String?
  payments  Payment[]
}

model Payment {
  id             String   @id @default(uuid())
  bookingId      String
  methodId       String?
  /// "pending" | "paid" | "failed" | "refunded"
  status         String   @default("pending")
  amountUsdCents Int
  currencyCode   String
  fxRate         Float    @default(1)
  reference      String?
  /// The gateway that owns this payment: "xendit" | "paypal" | null.
  provider       String?
  /// The provider-side id (the Xendit invoice id, the PayPal order id).
  providerRef    String?
  /// The amount charged by the provider, in the provider currency (cents).
  providerAmountCents Int?
  providerCurrency     String?
  /// The checkout URL the customer was redirected to.
  checkoutUrl    String?
  expiresAt      DateTime?
  paidAt         DateTime?
  /// The raw provider payload, kept for auditing.
  rawPayload     Json?
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id])
  method         PaymentMethod? @relation(fields: [methodId], references: [id])

  @@index([providerRef])
}

/// A webhook event received from a gateway — the dedupe/audit ledger.
model PaymentWebhookEvent {
  id           String   @id @default(uuid())
  /// The gateway: "xendit" | "paypal".
  provider     String
  /// The provider's event id — unique per provider, so a replay is ignored.
  providerEventId String
  /// The event type, e.g. "invoice.paid".
  eventType    String
  /// "processed" | "ignored" | "failed".
  outcome      String   @default("processed")
  /// The raw payload as received.
  payload      Json?
  receivedAt   DateTime @default(now())

  @@unique([provider, providerEventId])
}

/// A browser push subscription (Web Push / VAPID).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  /// The push service endpoint — unique per browser profile.
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Currency {
  code        String        @id
  name        String
  symbol      String
  decimals    Int           @default(2)
  locale      String        @default("en-US")
  isDefault   Boolean       @default(false)
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  rate        ExchangeRate?
}

model ExchangeRate {
  code       String   @id
  ratePerUsd Float
  /// ISO date (YYYY-MM-DD) this rate is quoted for.
  rateDate   String
  fetchedAt  DateTime @default(now())
  currency   Currency @relation(fields: [code], references: [code])
}

model Airline {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  active Boolean @default(true)
}

model Country {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  dialCode String
  active   Boolean @default(true)
}

/// A file stored in Cloudflare R2 (S3-compatible object storage).
///
/// One row per object. `ownerType`/`ownerId` point at the content the file
/// belongs to, so a single content row can carry several images (a gallery).
model Media {
  id         String   @id @default(uuid())
  /// The content model that owns the file — "Product", "Airport", "Banner",
  /// "Promo", "Article", "Destination" or "ServiceLine".
  ownerType  String
  /// The id of the owning row.
  ownerId    String
  /// The object key inside the bucket, e.g. "products/meet-greet.jpg".
  key        String
  /// The URL the browser loads. Either the public R2/CDN URL or the app's
  /// own `/media/<key>` proxy — both are stable, never signed.
  url        String
  /// Alternative text for the image.
  alt        String?
  /// Attribution line — author + licence + source page.
  credit     String?
  /// Pixel size, so the layout does not shift while the image loads.
  width      Int?
  height     Int?
  /// Position of the file inside its gallery.
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([ownerType, ownerId])
  @@index([key])
}

/// A promo card on the home page.
model Promo {
  id          String  @id @default(uuid())
  slug        String  @unique
  titleEn     String
  titleId     String?
  subtitleEn  String?
  subtitleId  String?
  imageUrl    String?
  imageCredit String?
  tone        String  @default("from-blue-500 to-indigo-700")
  lineId      String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  line        ServiceLine? @relation(fields: [lineId], references: [id])
}

/// A full-width promotional strip.
model Banner {
  id          String  @id @default(uuid())
  slug        String  @unique
  titleEn     String
  titleId     String?
  subtitleEn  String?
  subtitleId  String?
  ctaEn       String?
  ctaId       String?
  ctaHref     String?
  /// Where the banner is shown, e.g. "home".
  placement   String  @default("home")
  imageUrl    String?
  imageCredit String?
  tone        String  @default("from-blue-600 to-indigo-800")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

/// A travel guide / article.
model Article {
  id          String  @id @default(uuid())
  slug        String  @unique
  titleEn     String
  titleId     String?
  categoryEn  String?
  categoryId  String?
  excerptEn   String?
  excerptId   String?
  imageUrl    String?
  imageCredit String?
  tone        String  @default("from-sky-400 to-blue-600")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

/// A destination tile on the home page.
model Destination {
  id          String  @id @default(uuid())
  slug        String  @unique
  nameEn      String
  nameId      String?
  countryEn   String?
  countryId   String?
  imageUrl    String?
  imageCredit String?
  tone        String  @default("from-rose-400 to-red-600")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

/// A link in one of the home SEO link grids.
model SeoLink {
  id        String  @id @default(uuid())
  slug      String  @unique
  labelEn   String
  labelId   String?
  href      String
  /// The service this link points at ("Airport VIP Service", "Transport", …).
  service   String?
  /// "recommendations" | "services"
  group     String  @default("recommendations")
  /// Extra filter keys (e.g. a destination).
  tags      Json    @default("[]")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

/// A block of SEO copy on the home page.
model SeoBlock {
  id        String  @id @default(uuid())
  slug      String  @unique
  titleEn   String
  titleId   String?
  /// [{ heading, body }]
  sections  Json    @default("[]")
  /// [{ heading, body }] — Indonesian copy.
  sectionsId Json   @default("[]")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

/// A field of the home search form, scoped to a service line.
model SearchField {
  id            String  @id @default(uuid())
  lineId        String
  key           String
  labelEn       String
  labelId       String?
  placeholderEn String?
  placeholderId String?
  /// Icon slot: "plane" | "pin" | "cal" | "users" | "star"
  icon          String  @default("pin")
  /// Field kind — decides how the field renders.
  kind          String  @default("text")
  sortOrder     Int     @default(0)
  active        Boolean @default(true)
  line          ServiceLine @relation(fields: [lineId], references: [id])

  @@unique([lineId, key])
}

/// A key/value setting — hero copy, footer, tabs, quick time slots, …
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
